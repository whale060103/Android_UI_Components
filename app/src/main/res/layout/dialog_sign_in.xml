<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 第一部分：橙色标题栏 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFC107"
        android:text="ANDROID APP"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        android:padding="16dp"
        android:textStyle="bold" />

    <!-- 第二部分：输入框区域，这里放两个 EditText -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 用户名输入框 -->
        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword" />

        <!-- ⭐️ 你的任务：仿照上面，自己写一个密码输入框 -->
        <!-- 提示：密码框的 id 叫 et_password，hint 叫 Password，inputType 应该是 textPassword -->
        <!-- 这里你自己写 -->

    </LinearLayout>

    <!-- 第三部分：底部两个按钮（水平排列，平分宽度） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Cancel 按钮 -->
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn_sign_in"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sign in"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000" />

        <!-- ⭐️ 你的任务：仿照上面，写一个 Sign in 按钮 -->
        <!-- 提示：id 叫 btn_sign_in，text 叫 Sign in，layout_weight 也是 1 -->
        <!-- 这里你自己写 -->

    </LinearLayout>

</LinearLayout>