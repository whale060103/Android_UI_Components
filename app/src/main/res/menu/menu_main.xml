<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 字体大小（这是一个父菜单，里面嵌套了一个 menu 作为子菜单） -->
    <item
        android:id="@+id/menu_font_size"
        android:title="字体大小">
        <menu>
            <!-- 子菜单里，加上单选属性 -->
            <group android:checkableBehavior="single">
                <item android:id="@+id/font_small" android:title="小 (10号字)" />
                <item android:id="@+id/font_medium" android:title="中 (16号字)" />
                <item android:id="@+id/font_large" android:title="大 (20号字)" />
            </group>
        </menu>
    </item>

    <!-- 2. 普通菜单项 -->
    <item
        android:id="@+id/normal_item"
        android:title="普通菜单项" />

    <!-- 3. 字体颜色（也是父菜单，里面嵌套 menu） -->
    <item
        android:id="@+id/menu_font_color"
        android:title="字体颜色">
        <menu>
            <group android:checkableBehavior="single">
                <item android:id="@+id/color_red" android:title="红色" />
                <item android:id="@+id/color_black" android:title="黑色" />
            </group>
        </menu>
    </item>

</menu>